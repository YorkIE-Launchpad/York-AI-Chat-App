# Production env for packaged builds (`npm run build`).
# Copy to `.env.prod` and fill in production Hub / Cognito values.
# Dev continues to use `.env`.

# Hub / Cognito authentication
HUB_API_URL=https://api.hub.yorkdevs.link
VITE_HUB_API_URL=https://api.hub.yorkdevs.link
LAUNCHPAD_MCP_URL=https://launchpad.yorkdevs.link/mcp
RND_PULSE_MCP_URL=https://pulse.yorkdevs.link/mcp
HUB_MCP_URL=https://mcp.hub.yorkdevs.link/mcp
GTM_PULSE_MCP_URL=https://gtm-pulse.yorkdevs.link/mcp
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_APP_CLIENT_ID=
AUTH_ALLOWED_DOMAIN=@york.ie

# Desktop OAuth: Hub must allow http://127.0.0.1:<port>/auth/callback
# VITE_FRONTEND_URL / VITE_HUB_OAUTH_REDIRECT_URL are mainly for Vite-dev;
# packaged builds use the loopback OAuth relay.

# Desktop connector OAuth (Slack / Gmail / Google Drive)
# Slack/Google redirect (loopback):
#   http://127.0.0.1:19891/callback
# CONNECTOR_OAUTH_CALLBACK_PORT=19891
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Optional: pin Slack MCP to a specific team_id (York.ie workspace).
# SLACK_ALLOWED_TEAM_ID=
# GOOGLE_CONNECTOR_CLIENT_ID=
# GOOGLE_CONNECTOR_CLIENT_SECRET=
# Zoom General App — Redirect + Allow List must match ZOOM_OAUTH_REDIRECT_URI exactly.
# Event Notification (webhooks): POST https://<york-backend>/zoom/webhooks — not /zoom/sessions.
# ZOOM_CONNECTOR_CLIENT_ID=
# ZOOM_CONNECTOR_CLIENT_SECRET=
# Prod (all users): public York backend bridge — path MUST be /oauth/zoom/callback
#   (bare /callback hits Cognito and is wrong).
# ZOOM_OAUTH_REDIRECT_URI=https://api.vecos.yorkdevs.link/oauth/zoom/callback
# Local/dev (optional): hosts-mapped domain → local listener (no backend bridge)
#   /etc/hosts: 127.0.0.1 zoom-dev.york.ie
# ZOOM_OAUTH_REDIRECT_URI=http://zoom-dev.york.ie:19891/callback


# Optional remote backend (defaults to local proxy when unset)
# YORK_IE_BACKEND_URL=http://127.0.0.1:3001
