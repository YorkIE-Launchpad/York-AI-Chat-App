PORT=3001

# Cloud provider API keys (only providers with keys appear in GET /models,
# except OpenRouter which is always listed — users supply their own key in the app)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cognito JWT verification (same pool/client as the Electron app)
# Required for /models and all provider proxy routes
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_APP_CLIENT_ID=

# Zoom Marketplace General App (RTMS webhooks + OAuth client)
# ZOOM_CONNECTOR_CLIENT_ID=
# ZOOM_CONNECTOR_CLIENT_SECRET=
# ZOOM_WEBHOOK_SECRET_TOKEN=

# Zoom Marketplace Event Notification URL must be:
#   POST https://<york-backend>/zoom/webhooks
# Do NOT point it at /zoom/sessions/* (those require Cognito JWT from the desktop app).
# OAuth redirect: /oauth/zoom/callback (public bridge) or hosts/loopback :19891/callback.
# HOST=0.0.0.0

# Zoom OAuth public bridge (GET /oauth/zoom/callback) — used when ZOOM_OAUTH_REDIRECT_URI points here.
# CONNECTOR_OAUTH_CALLBACK_PORT=19891
# Handoff target for the bridge HTML → Electron listener. MUST be loopback, NEVER the public
# /oauth/zoom/callback URL (that causes an infinite "Connecting Zoom…" reload loop).
ZOOM_OAUTH_LOCAL_CALLBACK_URL=http://127.0.0.1:19891/callback

# ZM_RTMS_CLIENT=
# ZM_RTMS_SECRET=
# Minimum Electron app version (default 3.3.1). Requests without X-York-App-Version or with an older version get 426.
MIN_CLIENT_VERSION=3.3.1
