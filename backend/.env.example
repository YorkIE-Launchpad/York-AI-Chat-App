PORT=3001

# Cloud provider API keys (only providers with keys appear in GET /models)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# TypeSafe Jev (System One) — used by /typesafe proxy for decision calls
TYPESAFE_API_KEY=
# York shared LLM (llama.cpp) — /york-llm proxy with an org-wide request queue
YORK_LLM_API_KEY=
# YORK_LLM_UPSTREAM_URL=http://llm.yorkdevs.link:2222
# Must match llama.cpp --parallel (slots)
# YORK_LLM_MAX_CONCURRENT=15

# Cognito JWT verification (same pool/client as the Electron app)
# Required for /models and all provider proxy routes
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_APP_CLIENT_ID=

# Desktop connector OAuth (POST /connectors/oauth/:provider/token, Cognito required).
# Client secrets live ONLY here — never in the Electron app's .env / .env.prod.
# Client IDs must match the desktop app's SLACK_CLIENT_ID / GOOGLE_CONNECTOR_CLIENT_ID.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# GOOGLE_CONNECTOR_CLIENT_ID=
# GOOGLE_CONNECTOR_CLIENT_SECRET=

# Slack remote control relay (DM the York bot from Slack to drive your own desktop).
# Disabled unless SLACK_RELAY_ENABLED=true AND every value below is set.
# Slack app: bot scopes chat:write, im:history, im:write, users:read, users:read.email;
# bot event message.im; Request URL POST https://<york-backend>/slack/events.
# Rotate the bot token / signing secret in Slack and here together.
# SLACK_RELAY_ENABLED=true
# SLACK_BOT_TOKEN=xoxb-
# SLACK_SIGNING_SECRET=
# SLACK_APP_ID=
# SLACK_ALLOWED_TEAM_ID=
# Comma-separated; defaults to york.ie. Optional per-user allowlist on top.
# SLACK_RELAY_ALLOWED_EMAIL_DOMAINS=york.ie
# SLACK_RELAY_ALLOWED_EMAILS=

# Zoom Marketplace General App (RTMS webhooks + OAuth client)
# ZOOM_CONNECTOR_CLIENT_ID=
# ZOOM_CONNECTOR_CLIENT_SECRET=
# ZOOM_WEBHOOK_SECRET_TOKEN=

# Zoom Marketplace Event Notification URL must be:
#   POST https://<york-backend>/zoom/webhooks
# Do NOT point it at /zoom/sessions/* (those require Cognito JWT from the desktop app).
# OAuth redirect: /oauth/zoom/callback (public bridge) or hosts/loopback :19891/callback.
# HOST=0.0.0.0

# Zoom OAuth public bridge (GET /oauth/zoom/callback) — used when ZOOM_OAUTH_REDIRECT_URI points here.
# CONNECTOR_OAUTH_CALLBACK_PORT=19891
# Handoff target for the bridge HTML → Electron listener. MUST be loopback, NEVER the public
# /oauth/zoom/callback URL (that causes an infinite "Connecting Zoom…" reload loop).
ZOOM_OAUTH_LOCAL_CALLBACK_URL=http://127.0.0.1:19891/callback

# ZM_RTMS_CLIENT=
# ZM_RTMS_SECRET=
# Minimum Electron app version (default 3.3.1). Requests without X-York-App-Version or with an older version get 426.
MIN_CLIENT_VERSION=3.3.1
