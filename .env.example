# API Configuration 
# Required: Set your API authentication token 
# ANTHROPIC_AUTH_TOKEN=your_api_key_here 
 
# # Optional: Custom API endpoint 
# ANTHROPIC_BASE_URL=https://openrouter.ai/api 
 
# # Optional: Model selection 
# CLAUDE_MODEL=anthropic/claude-sonnet-4.5 
 
# Optional: Custom Claude Code CLI path 
# IMPORTANT: Use forward slashes (/) on Windows, not backslashes (\) 
# CLAUDE_CODE_PATH=C:/Users/yourname/AppData/Roaming/npm/node_modules/@anthropic-ai/claude-code/cli.js

# Hub / Cognito authentication (Launchpad-compatible)
# HUB_API_URL=https://api.uat-hub.yorkdevs.link
# VITE_HUB_API_URL=https://api.uat-hub.yorkdevs.link
# LAUNCHPAD_MCP_URL=https://launchpad.yorkdevs.link/mcp
# RND_PULSE_MCP_URL=https://pulse.yorkdevs.link/mcp
# HUB_MCP_URL=https://mcp.uat-hub.yorkdevs.link/mcp
# GTM_PULSE_MCP_URL=https://gtm-pulse.yorkdevs.link/mcp
# AWS_COGNITO_USER_POOL_ID=
# AWS_COGNITO_APP_CLIENT_ID=
# AUTH_ALLOWED_DOMAIN=@york.ie
# Hub must allow http://127.0.0.1:<port>/auth/callback for desktop OAuth.

# Desktop connector OAuth (Slack / Gmail / Google Drive)
# Slack/Google redirect (loopback):
#   http://127.0.0.1:6789/callback
# CONNECTOR_OAUTH_CALLBACK_PORT=6789
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Optional: pin Slack MCP to a specific team_id (York.ie workspace).
# SLACK_ALLOWED_TEAM_ID=
# GOOGLE_CONNECTOR_CLIENT_ID=
# GOOGLE_CONNECTOR_CLIENT_SECRET=
# Zoom General App — Redirect + Allow List must match ZOOM_OAUTH_REDIRECT_URI exactly.
# ZOOM_CONNECTOR_CLIENT_ID=
# ZOOM_CONNECTOR_CLIENT_SECRET=
# Prod (all users): public York backend bridge
# ZOOM_OAUTH_REDIRECT_URI=https://your-york-backend.example/oauth/zoom/callback
# Local/dev (optional): hosts-mapped domain → local listener (no backend bridge)
#   /etc/hosts: 127.0.0.1 zoom-dev.york.ie
# ZOOM_OAUTH_REDIRECT_URI=http://zoom-dev.york.ie:6789/callback


#YORK_IE_BACKEND_URL=http://127.0.0.1:3001
# Local LLM proxy (backend/) — use the same Cognito pool/client IDs in backend/.env
# so proxy routes can verify JWTs. See backend/.env.example.

# Production builds (`npm run build`) load `.env.prod` instead.
# Copy `.env.prod.example` → `.env.prod` for packaged Hub / Cognito URLs.
