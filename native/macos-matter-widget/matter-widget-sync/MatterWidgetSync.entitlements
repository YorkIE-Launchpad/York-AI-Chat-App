<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Do NOT enable app-sandbox on this CLI helper — sandboxed command-line tools
	  outside an .app bundle abort at launch (SIGTRAP). Application Groups alone
	  are enough for FileManager.containerURL writes on the Team-ID-prefixed groups.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ie.york.app</string>
		<string>group.ie.york.vecos.dev</string>
		<string>7G87G26WW6.group.ie.york.app</string>
		<string>7G87G26WW6.group.ie.york.vecos.dev</string>
	</array>
</dict>
</plist>
